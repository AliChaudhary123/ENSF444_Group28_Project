# Base URL of the backend API (no trailing slash). Consumed by lib/api.ts.
#
# Local dev: leave unset to fall back to http://127.0.0.1:8000.
# Production: set this in Vercel (Project Settings -> Environment Variables)
#   BEFORE building, since NEXT_PUBLIC_* vars are inlined at build time.
#   Point it at your Render backend, e.g.:
NEXT_PUBLIC_API_URL=https://crime-forecast-api.onrender.com
